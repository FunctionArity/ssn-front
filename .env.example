# Where the Rails app runs. In development Vite proxies /api there, so the browser makes same-origin requests.
VITE_PROXY_TARGET=http://localhost:3000
# The API's origin when the front end is served elsewhere (production). Empty means same origin, through the proxy.
VITE_API_URL=
# Google sign-in: the same OAuth client id as the Rails app (credentials google.client_id). Empty hides the button.
VITE_GOOGLE_CLIENT_ID=
