# Copy to .env.local (or .env.development.local) to override the defaults in .env.development / .env.production.

# The Rails app that serves the JSON API (/api/v1).
VITE_API_URL=http://localhost:3000
# Google sign-in: the same OAuth client id as the Rails app (credentials google.client_id). Empty hides the button.
VITE_GOOGLE_CLIENT_ID=
